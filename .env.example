# Nalo Solutions SMS Configuration
SMS_API_KEY=your_nalo_api_key_here
SENDER_IDS=Kelly,YourSenderID
NALO_ENDPOINT=https://sms.nalosolutions.com/smsbackend/clientapi/Resl_Nalo/send-message/

# Webhook Callback Base URL
CALLBACK_BASE_URL=https://your-public-domain.com

# Database configuration
DATABASE_URL=sqlite:///./data/messages.db

# Auto-reconcile submitted messages in local testing
AUTO_RECONCILE=true

# Server configuration
HOST=0.0.0.0
PORT=8000
